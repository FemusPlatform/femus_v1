// ================================== NS_EQUATIONS ================================
void EquationsMap::initNavierStokes(EquationSystemsExtendedM& EqSys) {
#ifdef NS_EQUATIONS
  TRACKING_FUN(printf(" -> EquationsMap.C:initNavierStokes \n");)
// ==============================================================================================
  int nvars_in[3]= {0,0,0};
  const int NS_sol_type = _EquationsToAdd["MG_NavierStokes"];

  if(NDOF_K > 0) { nvars_in[0] = 1;  nvars_in[1] = 0; } // konstant(0) approx
  nvars_in[0]=0;   nvars_in[1]=0;    nvars_in[2]=1;        // quadratic(2) approx
int dim= EqSys.getMeshMG()->_dim;
  if(NS_sol_type == 1) {    // MONOLITHIC SOLVER
    // int dim =EqSys._mgmesh->_dim;
    nvars_in[2] = dim;   nvars_in[0] = 0;   nvars_in[1] = 1;  // linear(1) approx
    EqSys.AddSolver<MGSolNS_coup>("NS0", NS_F, nvars_in[0], nvars_in[1], nvars_in[2], "u");
  }
  if(NS_sol_type == 2) {   // PRESSURE FOR SEGREGATED SOLVER
    nvars_in[0]=0;   nvars_in[1]=0;    nvars_in[2]=1;        // quadratic(2) approx
    EqSys.AddSolver<MGSolNS_proj>("NS0X", NS_F, nvars_in[0], nvars_in[1], nvars_in[2], "u");
    EqSys.AddSolver<MGSolNS_proj>("NS0Y", NS_F + 1, nvars_in[0], nvars_in[1], nvars_in[2], "v");
if(dim == 3)  EqSys.AddSolver<MGSolNS_proj>("NS0Z", NS_F + 2, nvars_in[0], nvars_in[1], nvars_in[2], "w");

    nvars_in[0] = 0;    nvars_in[1] = 1;    nvars_in[2] = 0;  // only  Linear(1) approx
    EqSys.AddSolver<MGSolP>("NS2P", NS_F, nvars_in[0], nvars_in[1], nvars_in[2], "p");
  }
  if(NS_sol_type == 3) {   // RT  SOLVER
    nvars_in[0]=0;   nvars_in[1]=0;    nvars_in[2]=1;        // quadratic(2) approx
    EqSys.AddSolver<MGSolNS_projRT>("NS0X", NS_F, nvars_in[0], nvars_in[1], nvars_in[2], "u");
    EqSys.AddSolver<MGSolNS_projRT>("NS0Y", NS_F + 1, nvars_in[0], nvars_in[1], nvars_in[2], "v");
if(dim== 3)    EqSys.AddSolver<MGSolNS_projRT>("NS0Z", NS_F + 2, nvars_in[0], nvars_in[1], nvars_in[2], "w");
    nvars_in[2] = 0;   nvars_in[0] = 1;   nvars_in[1] = 1;  // linear(1) approx
    EqSys.AddSolver<MGSolPRT>("NS2P", NS_F, nvars_in[0], nvars_in[1], nvars_in[2], "p");
  }
// #if  defined  XFEM
 if(NS_sol_type == 4) { // XFEM SOLVER
    nvars_in[2] = dim;   nvars_in[0] = 0;   nvars_in[1] = 2; // quadratic(2) approx
    EqSys.AddSolver<MGSolNS_xfem>("NS0", NS_F, nvars_in[0], nvars_in[1], nvars_in[2], "u");
  }
// #endif 

// ==================================================
  TRACKING_FUN(printf(" <--- EquationsMap.C:initNavierStokes \n");)
#endif
  return;
}
