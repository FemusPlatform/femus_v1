    int nvars_in[3]= {0,FSIA_EQUATIONS % 2,((FSIA_EQUATIONS == 2) ? 1 : DIMENSION)}; // konst,linear,quad variables

    if(NDOF_K > 0) {
      nvars_in[0] = 1;  // konstant(0) approx
      nvars_in[1] = 0;
    }

#if FSIA_EQUATIONS != 2
    EqSys.AddSolver<MGSolFSIA>("FSIA0", FSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "ua");
#else
    EqSys.AddSolver<MGSolFSIA>("FSIA0X", FSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "ua");
    EqSys.AddSolver<MGSolFSIA>("FSIA0Y", FSA_F + 1, nvars_in[0], nvars_in[1], nvars_in[2], "va");
#if DIMENSION == 3
    EqSys.AddSolver<MGSolFSIA>("FSIA0Z", FSA_F + 2, nvars_in[0], nvars_in[1], nvars_in[2], "wa");
#endif
#endif
#if (FSIA_EQUATIONS % 2 == 0)  // - FSI_EQUATIONS==0,2  projection -
    nvars_in[0] = 0;
    nvars_in[1] = 1;
    nvars_in[2] = 0;  // only  Linear(1) approx
    EqSys.AddSolver<MGSolFSIAP>("FSIAP", FSA_F + 3, nvars_in[0], nvars_in[1], nvars_in[2], "pa");
#endif

// #ifdef DSA_EQUATIONS // -------------  Displacement adjoint--------------------
//   nvars_in[0]=0; nvars_in[1]=0;   // Costant(1)  Linear(0)
//   nvars_in[2]=1;                  // quadratic(2) Approximation
//
//   MGSolDSA* mgsdsdxa=new MGSolDSA(*this,nvars_in,"SDSAX","dxa");  init_eqs(mgsdsdxa);
//   MGSolDSA* mgsdsdya=new MGSolDSA(*this,nvars_in,"SDSAY","dya");  init_eqs(mgsdsdya);
// #if (DIMENSION==3)
//   MGSolDSA* mgsdsdza=new MGSolDSA(*this,nvars_in,"SDSAZ","dza");  init_eqs(mgsdsdza);
// #endif
    // ==============================================================================================
    TRACKING_FUN(printf(" -> EquationsMap.C: initAdjointFSIinitColor \n");) // ----------------  end  Disp adjoint
#endif
    return;
  }
// ================================== NSA_EQUATIONS ================================
  void EquationsMap::initAdjointNavierStokes(EquationSystemsExtendedM& EqSys) {

#ifdef NSA_EQUATIONS
    TRACKING_FUN(printf(" -> EquationsMap.C:initAdjointNavierStokes \n");)
    // =============================================================================================
    int nvars_in[3]= { ((NSA_EQUATIONS == 2) ? 1 : DIMENSION),0,NSA_EQUATIONS%2}; // konst,linear,quad variables

    if(NDOF_K > 0) {
      nvars_in[0] = 1;  // konstant(0) approx
      nvars_in[1] = 0;
    }

#if NSA_EQUATIONS == 2  // - NS_EQUATIONS==2 -
    EqSys.AddSolver<MGSolNSA>("NSA0X", NSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "ua");
    EqSys.AddSolver<MGSolNSA>("NSA0Y", NSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "va");
#if DIMENSION == 3
    EqSys.AddSolver<MGSolNSA>("NSA0Z", NSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "wa");
#endif
#endif
#if (NSA_EQUATIONS == 0 || NSA_EQUATIONS == 1)  // - NS_EQUATIONS==0,1 -
    EqSys.AddSolver<MGSolNSA>("NSA0", NSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "ua");
#endif

#if (NSA_EQUATIONS % 2 == 0)  // - NS_EQUATIONS==0,2  projection -
    nvars_in[0] = 0;
    nvars_in[1] = 1;
    nvars_in[2] = 0;  // only  Linear(1) approx
    EqSys.AddSolver<MGSolPA>("NSA2P", NSA_F, nvars_in[0], nvars_in[1], nvars_in[2], "pa");
#endif
    TRACKING_FUN(printf(" <- EquationsMap.C:initAdjointNavierStokes \n");)
#endif

    return;
  }
